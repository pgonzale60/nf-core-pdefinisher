nextflow.enable.moduleBinaries = true

params {
    delfies_args        = '--telomere-repeat TTAGGC'
    mosdepth_args       = '--by 500 --fast-mode'
    hifiasm_args        = '-f0 -k 21 -w 11'
    minimap2_align_args = '-x asm5'
}

process {
    withName: DELFIES {
        ext.args = { "${params.delfies_args}" }
    }

    withName: MOSDEPTH {
        ext.args = { "${params.mosdepth_args}" }
    }

    withName: BARRNAP {
        ext.args = ''
    }

    withName: EXTRACTTELOMERICREADS {
        ext.args = ''
    }

    withName: SOFTCLIPENDS {
        ext.args = ''
    }

    withName: HIFIASM {
        ext.args = { "${params.hifiasm_args}" }
    }

    withName: MINIMAP2_ALIGN {
        ext.args = { "${params.minimap2_align_args}" }
    }

    withName: SNIFFLES {
        cpus     = 8
        memory   = '16.GB'
        ext.args = '--mosaic --mosaic-af-min 0.01 --mosaic-include-germline'
    }

    withName: FILTERCHROMOSOMES {
        ext.args = ''
    }

    withName: RED {
        ext.args = ''
    }

    withName: 'ALIGN_UNPLACED' {
        ext.args = '-x asm20'
    }

    withName: EXTRACTRDNAREADS {
        ext.args = ''
    }

    withName: IDENTIFYPUTATIVEGRS {
        ext.args = ''
    }
}
