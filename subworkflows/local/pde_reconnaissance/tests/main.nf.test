nextflow_workflow {

    name "Test Subworkflow PDE_RECONNAISSANCE"
    script "../main.nf"
    workflow "PDE_RECONNAISSANCE"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows_sangertol"
    tag "subworkflows/pde_reconnaissance"
    tag "delfies"
    tag "mosdepth"
    tag "barrnap"
    tag "extracttelomericreads"
    tag "softclipends"
    tag "hifiasm"
    tag "minimap2/align"
    tag "sniffles"
    tag "filterchromosomes"
    tag "red"
    tag "extractrdnareads"
    tag "identifyputativegrs"
    tag "extractgapevidence"
    tag "telomericjunctionprofiler"
    tag "subworkflows/../../modules/sanger-tol/delfies"
    tag "subworkflows/../../modules/sanger-tol/barrnap"
    tag "subworkflows/../../modules/sanger-tol/sniffles"
    tag "subworkflows/../../modules/sanger-tol/filterchromosomes"
    tag "subworkflows/../../modules/sanger-tol/red"
    tag "subworkflows/../../modules/sanger-tol/extracttelomericreads"
    tag "subworkflows/../../modules/sanger-tol/extractrdnareads"
    tag "subworkflows/../../modules/sanger-tol/identifyputativegrs"
    tag "subworkflows/../../modules/sanger-tol/softclipends"
    tag "subworkflows/../../modules/sanger-tol/hifiasm"
    tag "subworkflows/../../modules/sanger-tol/minimap2/align"
    tag "subworkflows/../../modules/sanger-tol/telomericjunctionprofiler"
    tag "subworkflows/../../modules/nf-core/mosdepth"

    setup {
        if (!file("${baseDir}/modules/nf-core").exists()) {
            nfcoreInitialise("${launchDir}/library/")
            nfcoreInstall(
                "${launchDir}/library/",
                [
                    "mosdepth"
                ]
            )
            nfcoreLink("${launchDir}/library/", "${baseDir}/modules/")
        }
    }

    test("pde - stub") {

        options "-stub"

        when {
            params {
                delfies_args        = '--telomere-repeat TTAGGC'
                mosdepth_args       = '--by 1000 --fast-mode'
                hifiasm_args        = '-f0 -k 21 -w 11'
                minimap2_align_args = '-x asm5'
            }
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [ id: "test_sample" ],
                        file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                    ]
                )

                input[1] = Channel.of(
                    [
                        [ id: "test_sample" ],
                        file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                        file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                    ]
                )

                input[2] = "TTAGGC"
                input[3] = "MT192765.1"
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }

        cleanup {
            if (file("${launchDir}/library/").exists()) {
                nfcoreUnlink("${launchDir}/library/", "${baseDir}/modules/nf-core")
            }
        }
    }
}
