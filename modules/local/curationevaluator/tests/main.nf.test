nextflow_process {

    name "Test Process CURATIONEVALUATOR"
    script "../main.nf"
    process "CURATIONEVALUATOR"

    tag "modules"
    tag "modules_sangertol"
    tag "curationevaluator"

    test("gfAmaRube1 - stub") {

        // Stub only: exercises the interface and the emitted outputs. The blueprint,
        // AGP, audit table and patch manifests are pipeline intermediates with no
        // counterpart in the shared test data, so stand-in files are used.
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    file(params.nfcore_modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/genome/genome.fna.gz', checkIfExists: true),
                    file(params.nfcore_modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.annotated_intervals.tsv', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'Amanita_rubescens/assembly/gfAmaRube1_pretext.agp', checkIfExists: true),
                    [],
                    [],
                    [],
                    [],
                    [],
                    [],
                    file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
