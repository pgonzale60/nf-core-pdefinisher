nextflow_process {

    name "Test Process CURATIONVALIDATION"
    script "../main.nf"
    process "CURATIONVALIDATION"

    tag "modules"
    tag "modules_sangertol"
    tag "curationvalidation"

    test("test - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    [],
                    file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf', checkIfExists: true),
                    [],
                    [],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
