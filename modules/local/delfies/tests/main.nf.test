nextflow_process {

    name "Test Process DELFIES"
    script "../main.nf"
    process "DELFIES"

    tag "modules"
    tag "modules_sangertol"
    tag "delfies"

    config "./nextflow.config"

    test("nematode - bam - stub") {

        options "-stub"

        when {
            params {
                delfies_args = '--telomere-repeat TTAGGC'
            }
            process {
                """
                input[0] = [
                    [ id: "test_sample" ],
                    file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }
}
