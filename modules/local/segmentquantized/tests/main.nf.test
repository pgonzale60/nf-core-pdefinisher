nextflow_process {

    name "Test Process SEGMENTQUANTIZED"
    script "../main.nf"
    process "SEGMENTQUANTIZED"

    tag "modules"
    tag "modules_sangertol"
    tag "segmentquantized"

    test("sarscov2 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed', checkIfExists: true) ]
                input[1] = [ [ id:'test' ], file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed', checkIfExists: true) ]
                input[2] = [ [ id:'test' ], file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed', checkIfExists: true) ]
                input[3] = [ [ id:'test' ], file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed', checkIfExists: true) ]
                input[4] = [ [ id:'test' ], file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed', checkIfExists: true) ]
                input[5] = [ [ id:'test' ], file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed', checkIfExists: true) ]
                input[6] = 'sarscov2'
