nextflow_process {

    name "Test Process EXTRACTGAPEEVIDENCE"
    script "../main.nf"
    process "EXTRACTGAPEVIDENCE"

    tag "modules"
    tag "modules_sangertol"
    tag "extractgapevidence"

    test("sarscov2 - fasta_bam - stub") {

        // Stub only: exercises the interface and the emitted outputs. Structural
        // variant calls are optional here and come from Sniffles upstream, so no
        // VCF is supplied.
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
