nextflow_process {

    name "Test Process TELOMERICJUNCTIONPROFILER"
    script "../main.nf"
    process "TELOMERICJUNCTIONPROFILER"

    tag "modules"
    tag "modules_sangertol"
    tag "telomericjunctionprofiler"

    config "./nextflow.config"

    test("sarscov2 - fastq - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: "test_sample" ],
                    file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                    file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    [],
                    file(projectDir + '/assets/curation_policy.json', checkIfExists: true)
                ]
                input[1] = 'TTAGGC'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
