nextflow_process {

    name "Test Process CURATIONSUMMARY"
    script "../main.nf"
    process "CURATIONSUMMARY"

    tag "modules"
    tag "modules_sangertol"
    tag "curationsummary"

    test("cohort - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'cohort' ],
                    [
                        file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
