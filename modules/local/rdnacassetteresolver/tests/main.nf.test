nextflow_process {

    name "Test Process RDNACASSETTERESOLVER"
    script "../main.nf"
    process "RDNACASSETTERESOLVER"

    tag "modules"
    tag "modules_sangertol"
    tag "rdnacassetteresolver"

    test("mMelMel3 - fasta - stub") {

        // Stub only: exercises the interface and the emitted outputs. The blueprint,
        // Flye assembly info and PAF are pipeline intermediates with no counterpart
        // in the shared test data, so stand-in files are used.
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.nfcore_modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.annotated_intervals.tsv', checkIfExists: true),
                    file(params.nfcore_modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    file(params.nfcore_modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/genome/genome.fna.gz', checkIfExists: true),
                    [],
                    [],
                    file(params.modules_testdata_base_path + 'Meles_meles/assembly/release/mMelMel3.1_paternal_haplotype/GCA_922984935.2.subset.fasta.gz', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
