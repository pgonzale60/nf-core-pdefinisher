params {
    max_memory = 600.GB
    max_cpus   = 64
    max_time   = 11.h
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/nfs/users/nfs_p/pg17/singularity_cache'
    runOptions = '--bind /lustre --bind /nfs --bind /data --bind /software'
}

process {
    executor       = 'lsf'
    queue          = 'normal'
    beforeScript   = 'module load ISG/singularity/3.11.4'

    time           = 11.h
    errorStrategy  = { task.exitStatus in [130, 137, 140, 143] ? 'retry' : 'finish' }
    maxRetries     = 2

    // Cap all nf-core base label times to 11.h so LSF normal queue (max 12.h) accepts them
    withLabel: 'process_single|process_low|process_medium|process_high|process_long' {
        time       = 11.h
    }

    // Surgical curation engines: dynamically scale memory on retry
    withName: '.*:TELOMEREWALKER|.*:TARGETEDGAPASSEMBLY|.*:RDNACASSETTERESOLVER|.*:TRANSCHROMOSOMALLINKRESOLVER|.*:CURATIONEVALUATOR|.*:CURATIONVALIDATION' {
        cpus       = 4
        memory     = { 32.GB * task.attempt }
        time       = 11.h
        maxRetries = 2
    }

    withName: '.*:HIFIASM_RDNA' {
        cpus       = 8
        memory     = 32.GB
        time       = 11.h
    }

    withName: '.*:MINIMAP2_ALIGN' {
        cpus       = 16
        memory     = 32.GB
        time       = 11.h
    }

    withName: '.*:ALIGN_UNPLACED|.*:ALIGN_RDNA_TO_ASSEMBLY' {
        cpus       = 4
        memory     = 16.GB
        time       = 11.h
    }

    withName: '.*:SNIFFLES' {
        cpus       = 8
        memory     = 32.GB
        time       = 11.h
    }
}

executor {
    name            = 'lsf'
    perJobMemLimit  = true
    submitRateLimit = '5 sec'
    killBatchSize   = 50
    queueSize       = 100
}
