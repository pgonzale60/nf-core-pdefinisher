/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    withName: '.*:DELFIES' {
        ext.args = { params.delfies_args }
    }

    withName: '.*:MOSDEPTH' {
        ext.args = { params.mosdepth_args }
    }

    withName: '.*:HIFIASM' {
        ext.args = { params.hifiasm_args }
    }

    withName: '.*:MINIMAP2_ALIGN' {
        ext.args = { params.minimap2_align_args }
    }

    withName: '.*:ALIGN_UNPLACED' {
        ext.args   = "-x asm5 --secondary=no"
        ext.prefix = { "${meta.assembly_name}.unplaced_to_chr" }
    }

    withName: '.*:(ASMFORMATQC|BARRNAP|BGZIPFASTA|BIPARTITEPROFILER|BUILD_VALIDATION_PACKAGE|CHARACTERIZE_RESIDUE|CURATIONAGPGENERATOR|CURATIONEVALUATOR|CURATIONSYNTHESIS|CURATIONVALIDATION|DELFIES|DELFIESBREAKWINDOWS|EXTRACTGAPEVIDENCE|EXTRACTRDNAREADS|EXTRACTTELOMERICREADS|EXTRACT_UNMAPPED_HIFI|FILTERCHROMOSOMES|FIMO|GFASTATSGAPS|HIFIASM|HIFIASM_RESIDUE|IDENTIFYPUTATIVEGRS|MASH_DECONTAMINATE|MEMECOREGRID|MINIMAP2_ALIGN|MITOHIFI_SEGREGATE|MODDOTPLOT|MOSDEPTHCLASS|MOSDEPTHQUANTIZE|PDEMOTIFPROFILER|RAGTAG_AGPCHECK|RDNACASSETTERESOLVER|RED|SEGMENTQUANTIZED|SNIFFLES|SOFTCLIPENDS|TARGETEDGAPASSEMBLY|TELOCLIP_EXTRACT|TELOMEREWALKER|TELOMERICJUNCTIONPROFILER|TRANSCHROMOSOMALLINKRESOLVER)' {
        ext.prefix = { meta.assembly_name ?: error("assembly_name is required in the samplesheet (sample: ${meta.id})") }
    }

    withName: '.*:SEGMENTQUANTIZED' {
        ext.prefix = { (meta.assembly_name ?: error("assembly_name is required in the samplesheet (sample: ${meta.id})")) + ".final" }
    }

    withName: '.*:SNIFFLES' {
        ext.args = "--minsupport 2 --mapq 0"
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
    }

}
